# Nuxt Configuration
# Copiar este archivo a .env.local y modificar según el ambiente

# URL pública del sitio (usado para SEO, sitemap, canonical URLs)
NUXT_PUBLIC_SITE_URL=https://periodent.com.ve

# URL base para las llamadas API (desarrollo vs producción)
NUXT_PUBLIC_API_URL=https://periodent.com.ve/api

# JWT Secret (debe coincidir con el del backend)
JWT_SECRET=8f6c7a2e9b4d41f1a7c0e5d93b2f6a8c4e1d9f7b3a5c0e2d8f4b6a1c9e7

# Ambiente (development, staging, production)
NODE_ENV=development
